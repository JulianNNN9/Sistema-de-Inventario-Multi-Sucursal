# Copy to .env to override defaults. docker-compose already provides these
# same values as inline defaults, so `docker compose up` works with no .env.

# --- PostgreSQL ---
POSTGRES_DB=optiplant
POSTGRES_USER=optiplant
POSTGRES_PASSWORD=optiplant_dev_pw

# --- Backend / JWT ---
# HS256 secret, must be at least 32 characters.
JWT_SECRET=dev_jwt_secret_change_me_0123456789_abcdefghij

# --- Backend / Datasource ---
# Host is the compose service name `db`.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/optiplant
