# Copy to .env to override defaults. docker-compose already provides these
# same values as inline defaults (except JWT_SECRET, see below), so
# `docker compose up` works with no .env.

# --- PostgreSQL ---
POSTGRES_DB=optiplant
POSTGRES_USER=optiplant
POSTGRES_PASSWORD=optiplant_dev_pw

# --- Backend / JWT (RNF-02) ---
# Deliberately left unset here: if you don't set it, docker-entrypoint.sh
# generates a random HS256 secret on first boot (`openssl rand -hex 32`) and
# persists it in the `jwt_secret` volume, so it survives container restarts.
# Set it explicitly only if you need a stable, known secret (e.g. to share
# tokens across machines). Must be at least 32 characters if you do.
# JWT_SECRET=

# --- Backend / Datasource ---
# Host is the compose service name `db`.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/optiplant
